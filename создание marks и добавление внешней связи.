//создание таблицы marks и добавление внешних связей.

CREATE TABLE marks (
    mark_id INT PRIMARY KEY AUTO_INCREMENT,
    stud_id INT NOT NULL,
    subj_id INT NOT NULL,
    mark INT NOT NULL CHECK (mark BETWEEN 1 AND 5),
    CONSTRAINT fk_student FOREIGN KEY (stud_id) REFERENCES students(student_id),
    CONSTRAINT fk_subject FOREIGN KEY (subj_id) REFERENCES subjects(subject_id)
);

